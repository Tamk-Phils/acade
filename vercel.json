{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --prefix frontend-react && npm run build --prefix frontend-react && rm -rf public && cp -r frontend-react/dist public",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py/$1"
    },
    {
      "source": "/((?!api|assets|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
