# Cloudflare D1 Serverless Database Configuration
# Find your Account ID in the Cloudflare Dashboard URL or Overview page.
# Generate API Token with "D1 Edit" permissions at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_DATABASE_ID=1ce80e78-f367-494d-aa47-5c87a8e02613
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional Supabase Alternative
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
PORT=8000
